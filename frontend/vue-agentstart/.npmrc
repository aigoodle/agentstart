# 阻止 pnpm 把 peerDependencies(vue / pinia / ant-design-vue /
# @ant-design/icons-vue) 物化进本包的 node_modules —— 消费方(vue-vben-admin
# / boot-school-web)必须提供，才能保证与宿主是同一个 Vue/pinia 实例。
# 否则会出现两个 Vue 实例：<KeepAlive> 路由切换后 provide/inject 断线,
# 页面白屏，需整浏览器刷新才好。
#
# 独立开发 aigoodle 组件时(单跑 vitest 之类)如果确实需要 peerDeps,
# 临时改成 true 或直接 `pnpm add -D vue pinia ant-design-vue @ant-design/icons-vue`。
auto-install-peers=false
