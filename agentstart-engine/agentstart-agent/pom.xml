        </dependency>
        <dependency>
            <groupId>io.aigoodle</groupId>
            <artifactId>agentstart-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aigoodle</groupId>
            <artifactId>agentstart-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aigoodle</groupId>
            <artifactId>agentstart-model</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aigoodle</groupId>
            <artifactId>agentstart-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aigoodle</groupId>
            <artifactId>agentstart-knowledge</artifactId>
